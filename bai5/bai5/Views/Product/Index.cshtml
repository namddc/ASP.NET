@* Khai báo kiểu Model truyền vào View là PaginatedList chứa danh sách ProductViewModel *@
@model bai5.Models.PaginatedList<bai5.ViewModel.ProductViewModel>

@{
    ViewData["Title"] = "Danh sách Product";
}

<h1>Index</h1>

@* =========================================================================
   FORM TÌM KIẾM
   - method="get": Đẩy tham số lên URL (?searchString=abc) để có thể bookmark/chia sẻ
   - value="@ViewBag.CurrentFilter": Giữ lại chữ người dùng đã gõ sau khi tải lại trang
   - input hidden "sortOrder": Giữ nguyên trạng thái sắp xếp hiện tại khi bấm tìm kiếm
   ========================================================================= *@
<form asp-action="Index" method="get">
    <p>
        Tìm kiếm: <input type="text" name="searchString" value="@ViewBag.CurrentFilter" placeholder="Nhập tên hoặc ID..." />
        <input type="hidden" name="sortOrder" value="@ViewBag.CurrentSort" />
        <input type="submit" value="Search" class="btn btn-primary btn-sm" />
        <a asp-action="Index">Quay lại danh sách</a>
    </p>
</form>

<p>
    <a asp-action="Create">Create New</a>
</p>

@* =========================================================================
   BẢNG HIỂN THỊ DỮ LIỆU
   - Tiêu đề cột ProductId và Name có link sắp xếp
   - Khi bấm vào tiêu đề, truyền sortOrder tương ứng và giữ lại từ khóa tìm kiếm (currentFilter)
   ========================================================================= *@
<table class="table">
    <thead>
        <tr>
            <th>
                @* Link sắp xếp theo ProductId (tăng dần/giảm dần) *@
                <a asp-action="Index" 
                   asp-route-sortOrder="@ViewBag.IdSortParm" 
                   asp-route-currentFilter="@ViewBag.CurrentFilter">
                    ProductId
                    @(ViewBag.CurrentSort == "id_desc" ? "▼" : "▲")
                </a>
            </th>
            <th>
                @* Link sắp xếp theo Name *@
                <a asp-action="Index" 
                   asp-route-sortOrder="@ViewBag.NameSortParm" 
                   asp-route-currentFilter="@ViewBag.CurrentFilter">
                    Name
                    @(ViewBag.CurrentSort == "name_desc" ? "▼" : (ViewBag.CurrentSort == "name_asc" ? "▲" : ""))
                </a>
            </th>
            <th>Description</th>
            <th>Price</th>
            <th>CategoryName</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@* Lặp qua từng sản phẩm trong trang hiện tại *@
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ProductId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CategoryName)
            </td>
            <td>
                @* Các liên kết thao tác chuẩn Visual Studio scaffolding *@
                @Html.ActionLink("Edit", "Edit", new { id = item.ProductId }) |
                @Html.ActionLink("Details", "Details", new { id = item.ProductId }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.ProductId })
            </td>
        </tr>
}
    </tbody>
</table>

@* =========================================================================
   KHU VỰC PHÂN TRANG (PAGINATION)
   - Hiển thị thông tin: Trang hiện tại / Tổng số trang (Tổng số bản ghi)
   - Nút "Trước" (Previous): Bị mờ (disabled) khi đang ở trang 1
   - Các nút số trang (1, 2, 3...): Trang đang xem sẽ có class "active"
   - Nút "Sau" (Next): Bị mờ (disabled) khi đang ở trang cuối
   ========================================================================= *@
<div>
    <span>Trang @Model.PageIndex / @(Model.TotalPages == 0 ? 1 : Model.TotalPages) (Tổng: @Model.TotalItems)</span>
    <ul class="pagination pagination-sm d-inline-flex ms-3">
        @* Nút chuyển về trang trước *@
        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
            <a class="page-link" asp-action="Index"
               asp-route-pageNumber="@(Model.PageIndex - 1)"
               asp-route-sortOrder="@ViewBag.CurrentSort"
               asp-route-currentFilter="@ViewBag.CurrentFilter">Trước</a>
        </li>

        @* Vòng lặp in ra từng số trang *@
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@i"
                   asp-route-sortOrder="@ViewBag.CurrentSort"
                   asp-route-currentFilter="@ViewBag.CurrentFilter">@i</a>
            </li>
        }

        @* Nút chuyển sang trang tiếp theo *@
        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
            <a class="page-link" asp-action="Index"
               asp-route-pageNumber="@(Model.PageIndex + 1)"
               asp-route-sortOrder="@ViewBag.CurrentSort"
               asp-route-currentFilter="@ViewBag.CurrentFilter">Sau</a>
        </li>
    </ul>
</div>
